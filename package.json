{
  "name": "koan-plus",
  "private": true,
  "version": "1.3.0",
  "description": "A local-only academic dashboard for Osaka University KOAN and CLE.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-manifest.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "zip": "npm run build && node scripts/build-zip.mjs",
    "version": "node scripts/sync-manifest.mjs && git add manifest.json public/manifest.json"
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "fflate": "^0.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
